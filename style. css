
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

html {
  scroll-padding-top: 85px;
}

body {
  font-family: Arial, sans-serif;
  background: #10091c;
  color: white;
}

header {
  background: #1d1230;
  padding: 20px 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.logo {
  color: #c084fc;
  font-size: 25px;
  font-weight: bold;
  text-decoration: none;
}

nav a {
  color: white;
  text-decoration: none;
  margin: 8px;
  transition: 0.3s;
}

nav a:hover {
  color: #c084fc;
}

section {
  padding: 65px 10%;
  scroll-margin-top: 85px;
}

small {
  color: #c084fc;
  letter-spacing: 2px;
}

h1 {
  font-size: 30px;
  margin: 15px 0 25px;
}

h3 {
  color: #d8b4fe;
  margin-bottom: 12px;
}

p {
  line-height: 1.7;
  margin-bottom: 12px;
}

#about {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  background: linear-gradient(120deg, #211237, #56318a);
}

#about img {
  width: 220px;
  height: 250px;
  object-fit: cover;
  border-radius: 15px;
  border: 3px solid #c084fc;
  box-shadow: 0 0 20px #9333ea;
}

.intro {
  max-width: 600px;
}

.stats, .cards, .projects, .contact {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.stats div, .card {
  background: #241737;
  padding: 20px;
  border: 1px solid #51336f;
  border-radius: 12px;
  flex: 1;
  min-width: 180px;
}

.stats h2 {
  color: #c084fc;
}

.timeline {
  border-left: 3px solid #a855f7;
  padding-left: 25px;
}

.card {
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: #c084fc;
}

.card span, .tags {
  color: #c084fc;
  font-size: 13px;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  margin: 25px 0;
}

.skills div {
  background: #241737;
  padding: 20px;
  width: 110px;
  text-align: center;
  border-radius: 12px;
  transition: 0.3s;
}

.skills div:hover {
  transform: translateY(-5px);
  background: #38204f;
}

.skills i {
  color: #c084fc;
  font-size: 30px;
  margin-bottom: 10px;
}

.projects .card img {
  width: 100%;
  height: 130px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 15px;
}

.btn {
  display: inline-block;
  background: #9333ea;
  color: white;
  padding: 12px 20px;
  border-radius: 7px;
  text-decoration: none;
  transition: 0.3s;
}

.btn:hover {
  background: #c084fc;
}

.socials a {
  color: #c084fc;
  font-size: 25px;
  margin-right: 18px;
  transition: 0.3s;
}

.socials a:hover {
  color: white;
}

footer {
  background: #1d1230;
  text-align: center;
  padding: 20px;
}

@media (max-width: 700px) {
  header, #about {
    flex-direction: column;
    text-align: center;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  #about img {
    width: 180px;
    height: 200px;
  }
}
